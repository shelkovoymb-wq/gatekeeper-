# === GATEKEEPER PLATFORM ENV ===

# Node
NODE_ENV=production
API_PORT=3000

# URLs
PUBLIC_API_URL=https://gatekeeper.skud24.ru
PUBLIC_APP_URL=https://app.gatekeeper.skud24.ru
NEXT_PUBLIC_API_URL=https://gatekeeper.skud24.ru

# === DATABASE ===
DATABASE_URL=postgres://gatekeeper:gatekeeper@postgres:5432/gatekeeper
DB_PASSWORD=gatekeeper

# === REDIS ===
REDIS_URL=redis://:redis123@redis:6379
REDIS_PASSWORD=redis123

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWxyz

# === PAYMENT PROVIDERS (per client) ===

# YooKassa
YOOKASSA_SHOP_ID_CLIENT_1=123456
YOOKASSA_SECRET_CLIENT_1=test_secret_key_123456789

# CloudPayments
CLOUDPAYMENTS_PUBLIC_ID_CLIENT_1=pk_test_xxx
CLOUDPAYMENTS_API_SECRET_CLIENT_1=api_secret_key_xxx

# Robokassa
ROBOKASSA_MERCHANT_LOGIN_CLIENT_1=merchant_login
ROBOKASSA_PASSWORD1_CLIENT_1=password1_for_signature
# Пароль #2 — ОТДЕЛЬНЫЙ от Password1, используется Робокассой для подписи
# уведомлений на ResultURL. Обязателен для проверки подлинности вебхука.
ROBOKASSA_PASSWORD2_CLIENT_1=password2_for_result_signature

# Prodamus
PRODAMUS_API_KEY_CLIENT_1=api_key_xxx
PRODAMUS_SECRET_KEY_CLIENT_1=secret_key_xxx

# === n8n CONFIGURATION ===
N8N_URL=https://n8n.skud24.ru
GATEKEEPER_API_TOKEN=sk_live_xxxxx
GATEKEEPER_API_URL=https://gatekeeper.skud24.ru

# === EMAIL ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@gatekeeper.ru
SMTP_PASS=app_password_xxxxx
ADMIN_EMAIL=admin@gatekeeper.ru

# === ДВУХФАКТОРНАЯ АУТЕНТИФИКАЦИЯ (TOTP) ===
# Название, которое приложение-аутентификатор покажет рядом с кодом.
TOTP_ISSUER=Gatekeeper
# Сколько живёт промежуточный токен между «пароль верен» и «код введён».
TWO_FACTOR_CHALLENGE_TTL=5m

# === ВХОД ЧЕРЕЗ GOOGLE / ЯНДЕКС (OAuth 2.0) ===
# Провайдер включается, только когда заданы ОБЕ половины пары; иначе кнопка
# просто не появится на форме входа.
#
# Google: console.cloud.google.com → APIs & Services → Credentials →
#   OAuth client ID (тип «Web application»). В «Authorized redirect URIs»
#   добавьте: https://app.gatekeeper.skud24.ru/api/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
#
# Яндекс: oauth.yandex.ru → создать приложение, платформа «Веб-сервисы»,
#   доступы «Доступ к адресу электронной почты» + «Доступ к портрету и логину».
#   Redirect URI: https://app.gatekeeper.skud24.ru/api/auth/oauth/yandex/callback
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
#
# База для redirect_uri. По умолчанию — PUBLIC_APP_URL (callback обрабатывает
# кабинет на Next.js, а не сам API). Значение НЕ берётся из запроса — иначе
# это был бы открытый редирект.
OAUTH_REDIRECT_BASE_URL=
# true — первый вход через провайдера создаёт новый аккаунт;
# false — вход только тем, кто уже привязал сервис в настройках кабинета.
OAUTH_ALLOW_SIGNUP=true

# === CRYPTO ===
ENCRYPTION_KEY=base64_encoded_32byte_key_here_xxxxxxxxxxxxxxxx

# === LOGGING ===
LOG_LEVEL=info

# === AI SETUP ASSISTANT ===
# Без ключа ассистент работает в упрощённом guided-режиме (без диалога).
ANTHROPIC_API_KEY=sk-xxxxx
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# === OWNER PAYMENT ACCOUNTS ===
# Платежные реквизиты владельца платформы настраиваются через API:
# POST /owner/payment-accounts — добавить способ получения платежей (банк, карта, СБП, PayPal, крипто)
# GET  /owner/payment-accounts — список всех способов получения
# POST /owner/payment-accounts/:id/verify — верифицировать счет
# POST /owner/payouts — инициировать выплату на счет
# GET  /owner/payouts-stats — статистика по выплатам

# === SEO: подтверждение владения сайтом ===
# Код из Google Search Console (Настройки → Подтверждение прав → тег HTML,
# нужен только сам content="..." без <meta>) и из Яндекс.Вебмастера
# (Добавить сайт → Мета-тег). Не секреты, но задаются через env, чтобы не
# редеплоить код при получении/смене кода.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
