# ─── Gatekeeper env (скопируйте в .env и заполните) ───────────────────────────

NODE_ENV=development
API_PORT=3000

# Публичный базовый URL API — на него Telegram шлёт webhook'и ботов.
# В домашней лабе за Traefik: https://gatekeeper.skud24.ru
PUBLIC_API_URL=https://gatekeeper.skud24.ru
# Публичный URL кабинета (Next.js). Пока кабинета нет — совпадает с API-хостом;
# в Фазе 1 вынесем на отдельный поддомен (напр. app.gatekeeper.skud24.ru).
PUBLIC_APP_URL=https://gatekeeper.skud24.ru

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://gatekeeper:gatekeeper@postgres:5432/gatekeeper

# ─── Redis (BullMQ) ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Криптография ─────────────────────────────────────────────────────────────
# 32-байтный ключ (base64) для шифрования токенов ботов и ключей платёжных шлюзов.
# Сгенерировать: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# JWT-секрет для кабинета клиента (owner/client/staff)
JWT_SECRET=CHANGE_ME_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Интеграция с n8n (событийная периферия) ──────────────────────────────────
# Ядро постит доменные события из outbox на этот webhook n8n.
N8N_EVENTS_WEBHOOK_URL=https://n8n.skud24.ru/webhook/platform-events
# Токен, которым n8n авторизуется в REST API ядра (Bearer).
N8N_SERVICE_TOKEN=CHANGE_ME_service_token

# ─── Платформенный бот (общий бот для MVP / алертов) ──────────────────────────
# Токен основного бота платформы (можно временно взять существующего).
PLATFORM_BOT_TOKEN=
