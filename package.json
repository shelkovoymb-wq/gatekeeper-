{
  "name": "gatekeeper",
  "version": "0.1.0",
  "private": true,
  "description": "Gatekeeper — платформа управления закрытыми Telegram-каналами (gatekeeper.skud24.ru)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "//": "Подтяжка транзитивных зависимостей с известными уязвимостями. Прямых зависимостей на них у нас нет — версии тянут @nestjs/* и next, поэтому чинится только оверрайдами. Список проверять при обновлении next/nest: когда апстрим сам поднимет версию, строку можно убрать.",
    "overrides": {
      "multer": "^2.2.0",
      "lodash": "^4.18.1",
      "sharp": "^0.35.3",
      "postcss": "^8.5.26",
      "nanoid": "^3.3.18",
      "body-parser": "^1.20.6",
      "qs": "^6.15.3",
      "uuid": "^11.1.1",
      "file-type": "^21.3.4"
    }
  },
  "scripts": {
    "dev:api": "pnpm --filter @gatekeeper/api start:dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @gatekeeper/api db:generate",
    "db:migrate": "pnpm --filter @gatekeeper/api db:migrate",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
